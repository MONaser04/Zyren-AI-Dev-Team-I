# ============================================================
# AI Dev-Team — .gitignore
# ============================================================

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# === Virtual Environment ===
.venv/
venv/
ENV/

# === Environment Variables (API KEYS — NEVER COMMIT) ===
.env
.env.local
.env.*.local

# === IDE ===
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Docker ===
docker-volumes/

# === Testing / Coverage ===
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === uv ===
# uv.lock IS committed for reproducibility

# === Logs ===
*.log

# === Temporary / Backup ===
*.bak
*.tmp
*.orig

# === AI Agents — Runtime Data (NEVER COMMIT) ===
# Workflow artifacts (generated per-run)
artifacts/

# Optimization reports (generated per-run)
reports/

# Databases (local state, not portable)
*.db
*.sqlite

# Deep research outputs (generated per-query)
deep_research_data.csv
deep_research_report.json
deep_research_report.md

# Working memory (ephemeral per-session)
memory.json

# === Bayesian Routing — Runtime State (PERSONAL MODEL SCORES) ===
src/gateway/bayesian_state.json

# === Model Benchmarks — Runtime Data ===
src/gateway/model_benchmarks.json

# === Optimization — Local Feedback History ===
optim/feedback.db
optim/*.sqlite

# === Agents config ===
.agents/
