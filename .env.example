# ============================================================
# AI Dev-Team — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ----------------------------------------------------------
# LLM Provider API Keys (add the ones you use)
# ----------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=

# ----------------------------------------------------------
# LiteLLM Gateway
# ----------------------------------------------------------
LITELLM_MASTER_KEY=sk-local-dev-key
LITELLM_PORT=4000

# ----------------------------------------------------------
# Postgres — Event-Sourced State Store
# ----------------------------------------------------------
POSTGRES_USER=aidev
POSTGRES_PASSWORD=aidev_local
POSTGRES_DB=aidev_state
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aidev:aidev_local@localhost:5432/aidev_state

# ----------------------------------------------------------
# Qdrant — Vector Store
# ----------------------------------------------------------
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# ----------------------------------------------------------
# Jaeger / OpenTelemetry — Observability
# ----------------------------------------------------------
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ----------------------------------------------------------
# Cost & Safety Caps
# ----------------------------------------------------------
MAX_WORKFLOW_COST_USD=5.00
MAX_ITERATIONS_PER_TASK=10
