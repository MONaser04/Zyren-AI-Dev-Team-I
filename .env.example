# ============================================================
# AI Dev-Team — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ----------------------------------------------------------
# LLM Provider API Keys (10 Providers — add the ones you use)
# ----------------------------------------------------------
# Primary Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NVIDIA_NIM_API_KEY=

# Azure (requires both key + endpoint)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# AWS Bedrock (uses AWS SDK auth)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Open-source / Self-hosted
OLLAMA_BASE_URL=http://localhost:11434

# Alternative Providers
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
GROQ_API_KEY=

# ----------------------------------------------------------
# LiteLLM Gateway
# ----------------------------------------------------------
LITELLM_MASTER_KEY=sk-local-dev-key
LITELLM_PORT=4000

# ----------------------------------------------------------
# Postgres — Event-Sourced State Store
# ----------------------------------------------------------
POSTGRES_USER=aidev
POSTGRES_PASSWORD=aidev_local
POSTGRES_DB=aidev_state
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aidev:aidev_local@localhost:5432/aidev_state

# ----------------------------------------------------------
# Qdrant — Vector Store
# ----------------------------------------------------------
QDRANT_REST_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# ----------------------------------------------------------
# Jaeger / OpenTelemetry — Observability
# ----------------------------------------------------------
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ----------------------------------------------------------
# Langfuse — LLM Observability
# ----------------------------------------------------------
LANGFUSE_PORT=3000
LANGFUSE_SECRET=langfuse-local-secret
LANGFUSE_SALT=langfuse-local-salt
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ----------------------------------------------------------
# Cost & Safety Caps
# ----------------------------------------------------------
MAX_WORKFLOW_COST_USD=5.00
MAX_ITERATIONS_PER_TASK=10

# ----------------------------------------------------------
# HITL (Human-in-the-Loop) Configuration
# ----------------------------------------------------------
HITL_BACKEND=auto          # auto | cli | webhook
HITL_ENABLED_GATES=        # comma-separated: pre_code,post_test,security_review
HITL_WEBHOOK_URL=          # URL for webhook-based HITL
HITL_TIMEOUT=300           # seconds before auto-approve/skip

