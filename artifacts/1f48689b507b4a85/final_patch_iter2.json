{'created_at': datetime.datetime(2026, 7, 10, 10, 58, 46, 361826, tzinfo=datetime.timezone.utc), 'task_id': '638fd086bc93', 'workflow_id': '1f48689b507b4a85', 'iteration': 2, 'files': [{'created_at': datetime.datetime(2026, 7, 10, 10, 58, 46, 361813, tzinfo=datetime.timezone.utc), 'path': 'fibonacci.py', 'content': 'def fibonacci(n: int) -> int:\n    """\n    Return the n-th Fibonacci number using an iterative approach.\n\n    Args:\n        n: The index of the Fibonacci number to compute. Must be a non-negative integer.\n\n    Returns:\n        The n-th Fibonacci number.\n\n    Raises:\n        TypeError: If n is not an integer (booleans are rejected).\n        ValueError: If n is negative.\n\n    Examples:\n        >>> fibonacci(0)\n        0\n        >>> fibonacci(1)\n        1\n        >>> fibonacci(10)\n        55\n    """\n    if type(n) is not int:\n        raise TypeError(f"Expected int, got {type(n).__name__}")\n    if n < 0:\n        raise ValueError("n must be a non-negative integer")\n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n\n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    return b\n'}, {'created_at': datetime.datetime(2026, 7, 10, 10, 58, 46, 361820, tzinfo=datetime.timezone.utc), 'path': 'test_fibonacci.py', 'content': 'import pytest\nfrom fibonacci import fibonacci\n\n\ndef test_fibonacci_base_cases():\n    assert fibonacci(0) == 0\n    assert fibonacci(1) == 1\n\n\ndef test_fibonacci_known_values():\n    assert fibonacci(2) == 1\n    assert fibonacci(3) == 2\n    assert fibonacci(4) == 3\n    assert fibonacci(5) == 5\n    assert fibonacci(6) == 8\n    assert fibonacci(7) == 13\n    assert fibonacci(8) == 21\n    assert fibonacci(9) == 34\n    assert fibonacci(10) == 55\n    assert fibonacci(20) == 6765\n\n\ndef test_fibonacci_negative_raises():\n    with pytest.raises(ValueError):\n        fibonacci(-1)\n    with pytest.raises(ValueError):\n        fibonacci(-10)\n\n\ndef test_fibonacci_non_int_raises():\n    with pytest.raises(TypeError):\n        fibonacci(3.14)\n    with pytest.raises(TypeError):\n        fibonacci("5")\n    with pytest.raises(TypeError):\n        fibonacci(None)\n    with pytest.raises(TypeError):\n        fibonacci([1, 2, 3])\n\n\ndef test_fibonacci_boolean_rejected():\n    # bool is a subclass of int in Python, so we must explicitly reject it\n    with pytest.raises(TypeError):\n        fibonacci(True)\n    with pytest.raises(TypeError):\n        fibonacci(False)\n\n\ndef test_fibonacci_large_n():\n    # Test that iterative approach handles larger n without recursion limit issues\n    assert fibonacci(50) == 12586269025\n    assert fibonacci(100) == 354224848179261915075\n'}], 'explanation': 'Fixed the type check to use `type(n) is int` instead of `isinstance(n, int)` to properly reject boolean inputs (since bool inherits from int in Python). The function and tests are otherwise unchanged.'}