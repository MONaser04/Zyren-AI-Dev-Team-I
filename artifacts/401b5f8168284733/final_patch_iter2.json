{'created_at': datetime.datetime(2026, 7, 11, 4, 34, 49, 962729, tzinfo=datetime.timezone.utc), 'task_id': '66016bd1ccf3', 'workflow_id': '401b5f8168284733', 'iteration': 2, 'files': [{'created_at': datetime.datetime(2026, 7, 11, 4, 34, 49, 962711, tzinfo=datetime.timezone.utc), 'path': 'fibonacci.py', 'content': 'def fibonacci(n: int) -> int:\n    """\n    Return the n-th Fibonacci number using an iterative approach.\n\n    Args:\n        n: The index of the Fibonacci number to compute. Must be a non-negative integer.\n\n    Returns:\n        The n-th Fibonacci number (0-indexed: fibonacci(0) = 0, fibonacci(1) = 1).\n\n    Raises:\n        TypeError: If n is not an integer (including booleans).\n        ValueError: If n is negative.\n    """\n    # Reject booleans explicitly since bool is a subclass of int\n    if type(n) is bool:\n        raise TypeError("n must be an integer, not a boolean")\n    \n    if not isinstance(n, int):\n        raise TypeError("n must be an integer")\n    \n    if n < 0:\n        raise ValueError("n must be a non-negative integer")\n    \n    if n == 0:\n        return 0\n    if n == 1:\n        return 1\n    \n    a, b = 0, 1\n    for _ in range(2, n + 1):\n        a, b = b, a + b\n    \n    return b'}, {'created_at': datetime.datetime(2026, 7, 11, 4, 34, 49, 962719, tzinfo=datetime.timezone.utc), 'path': 'test_fibonacci.py', 'content': 'import pytest\nfrom fibonacci import fibonacci\n\n\ndef test_fibonacci_base_cases():\n    assert fibonacci(0) == 0\n    assert fibonacci(1) == 1\n\n\ndef test_fibonacci_known_values():\n    assert fibonacci(2) == 1\n    assert fibonacci(3) == 2\n    assert fibonacci(4) == 3\n    assert fibonacci(5) == 5\n    assert fibonacci(6) == 8\n    assert fibonacci(7) == 13\n    assert fibonacci(8) == 21\n    assert fibonacci(9) == 34\n    assert fibonacci(10) == 55\n\n\ndef test_fibonacci_larger_values():\n    assert fibonacci(20) == 6765\n    assert fibonacci(30) == 832040\n    assert fibonacci(40) == 102334155\n\n\ndef test_fibonacci_negative_raises():\n    with pytest.raises(ValueError):\n        fibonacci(-1)\n    with pytest.raises(ValueError):\n        fibonacci(-10)\n\n\ndef test_fibonacci_non_integer_raises():\n    with pytest.raises(TypeError):\n        fibonacci(3.14)\n    with pytest.raises(TypeError):\n        fibonacci("5")\n    with pytest.raises(TypeError):\n        fibonacci(None)\n    with pytest.raises(TypeError):\n        fibonacci([5])\n\n\ndef test_fibonacci_boolean_raises():\n    # Booleans are subclasses of int in Python, so they must be explicitly rejected\n    with pytest.raises(TypeError):\n        fibonacci(True)\n    with pytest.raises(TypeError):\n        fibonacci(False)\n\n\ndef test_fibonacci_iterative_not_recursive():\n    # This test ensures the function can handle large n without recursion depth issues\n    # If implemented recursively, this would hit RecursionError\n    result = fibonacci(1000)\n    # Just verify it returns an integer and doesn\'t crash\n    assert isinstance(result, int)\n    assert result > 0'}], 'explanation': 'Fixed the boolean type check by adding an explicit `type(n) is bool` check before the `isinstance(n, int)` check. This ensures booleans are rejected as required by the tests, since `bool` inherits from `int` in Python. The rest of the implementation remains the same with proper type hints, docstring, and error handling.'}